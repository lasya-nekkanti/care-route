# CareRoute Backend Environment Variables
PORT=5000
NODE_ENV=development

# LLM / Gemini Integration (Optional - System defaults to deterministic MOCK service)
# Set GEMINI_API_KEY to activate live AI triage when ready.
# If omitted or empty, CareRoute uses built-in smart mock classification.
GEMINI_API_KEY=

# Emergency & Crisis Support Contact Placeholders (Configurable campus contacts)
# NOTE: These are prototype placeholders, not real university contacts.
EMERGENCY_SUPPORT_NUMBER="999 / 911 (Placeholder)"
CRISIS_COUNSELLOR_CONTACT="Campus Mental Health Crisis Line - ext 4444 (Placeholder)"
CAMPUS_SECURITY_CONTACT="Campus Security / First Response - ext 5555 (Placeholder)"
